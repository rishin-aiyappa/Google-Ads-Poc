# Copy to .env and fill in. Never commit the filled-in .env.
#
# Nothing in this package hardcodes a secret. With nothing set, the scripts
# REFUSE to run and name what is missing -- there is deliberately no mock mode,
# so a run started by mistake can never produce invented rows.
#
# Unlike the Meta Ads package, which has exactly ONE secret, Google Ads has
# THREE, because it is an OAuth flow rather than a static token.

# === SECRETS -- never commit, never paste into a chat or ticket ============

# The OAuth client, from the Google Cloud Console project "Skypoint Google Ads
# PoC" (APIs & Services -> Credentials -> Create Credentials -> OAuth client
# ID, Application type "Desktop app"). Prerequisites in that project: Google
# Ads API enabled, OAuth consent screen configured (Audience = External), and
# every account used to authorize added under Google Auth Platform -> Audience
# -> Test users -- the app is unverified, so otherwise sign-in fails with
# "Error 403: access_denied". Skypoint app-level constants, the same for every
# client. See README.md, "Where this stands", step 1.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# The long-lived refresh token, minted ONCE against the MCC by running
# `python get_refresh_token.py` (sign in as a test user; click through the
# "Google hasn't verified this app" warning -- the script waits for it). This
# is the real credential every Google Ads instance uses -- there is one for the
# whole platform, not one per client.
GOOGLE_ADS_REFRESH_TOKEN=

# LEGACY / OPTIONAL -- leave blank. Google sunset developer tokens on
# September 9, 2026; the API now ignores this value and gates access through the
# Cloud project behind the OAuth credentials instead. New integrations apply for
# an API access level (Explorer, then Basic if needed) from the Google Ads API
# Overview page in Cloud Console -- not from the MCC's Admin -> API Centre.
GOOGLE_ADS_DEVELOPER_TOKEN=

# === NON-SECRET SCOPING INPUTS ============================================

# The client's Google Ads account -- this is what decides whose data comes
# back. In Studio it is a plain form field (isCredential: false).
# Hyphens are stripped automatically, so 123-456-7890 and 1234567890 both work.
# Kyrene School District is 829-530-3333. If this is blank the scripts refuse
# to run.
GOOGLE_ADS_CUSTOMER_ID=8295303333

# The MCC doing the authenticating: Skypoint Cloud Inc, 775-317-9425.
# Sent as the login-customer-id header. Omitting it when querying a client
# account under the MCC returns USER_PERMISSION_DENIED -- an error that reads
# like bad credentials but is really a missing header.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=7753179425

# === TUNING ===============================================================

# Google Ads API version. Must be a version Google currently supports: v21 was
# already sunset and returned 404. Roughly three versions ship a year and each
# is sunset about a year after release. If calls 404, check
# https://developers.google.com/google-ads/api/docs/sunset-dates and bump it.
GOOGLE_ADS_API_VERSION=v25

# Hard ceiling on requests/second, shared across every call in the process.
GOOGLE_ADS_RPS=5

# How far back each run re-pulls, to catch conversions attributed after the
# fact. This is a PER-ACCOUNT setting, not a constant: Google's default
# conversion window is 30 days but accounts can configure up to 90.
# Check the widest click_through_lookback_window_days on the account's
# conversion actions (90 days for Kyrene School District) and keep this at or
# above it.
GOOGLE_ADS_RESTATEMENT_DAYS=90
